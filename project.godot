; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="buttons-select"
config/version="0.0.4"
run/main_scene="uid://df8oaox7leo4k"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "red",
"res://samples/": "green",
"res://tests/": "pink"
}

[gdunit4]

settings/test/test_lookup_folder="tests"
Shortcuts/inspector/rerun_test=PackedInt32Array(4194326, 4194336)
Shortcuts/inspector/rerun_test_debug=PackedInt32Array(4194326, 4194337)
Shortcuts/inspector/run_test_overall=PackedInt32Array(4194326, 4194338)
Shortcuts/inspector/run_test_stop=PackedInt32Array(4194326, 4194339)
Shortcuts/filesystem/run_test=PackedInt32Array()
Shortcuts/filesystem/run_test_debug=PackedInt32Array()

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
